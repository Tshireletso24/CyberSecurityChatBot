<Window x:Class="CyberSecurityChatBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="700" Width="900"
        MinHeight="600" MinWidth="750"
        Background="#0D0D1A"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header / ASCII banner -->
            <RowDefinition Height="*"/>      <!-- Chat display area -->
            <RowDefinition Height="Auto"/>   <!-- Input area -->
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Background="#111127" Padding="15,12">
            <StackPanel>
                <!-- ASCII art banner -->
                <TextBlock x:Name="AsciiBanner"
                           FontFamily="Courier New"
                           FontSize="9"
                           Foreground="#00FFCC"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Text="  ██████╗██╗   ██╗██████╗ ███████╗██████╗ ██████╗  ██████╗ ████████╗&#10; ██╔════╝╚██╗ ██╔╝██╔══██╗██╔════╝██╔══██╗██╔══██╗██╔═══██╗╚══██╔══╝&#10; ██║      ╚████╔╝ ██████╔╝█████╗  ██████╔╝██████╔╝██║   ██║   ██║   &#10; ██║       ╚██╔╝  ██╔══██╗██╔══╝  ██╔══██╗██╔══██╗██║   ██║   ██║   &#10; ╚██████╗   ██║   ██████╔╝███████╗██║  ██║██████╔╝╚██████╔╝   ██║   &#10;  ╚═════╝   ╚═╝   ╚═════╝ ╚══════╝╚═╝  ╚═╝╚═════╝  ╚═════╝    ╚═╝  "/>

                <!-- Subtitle -->
                <TextBlock Text="🛡  Cybersecurity Awareness Assistant  🛡"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#7EB8F7"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>

                <!-- Divider -->
                <Separator Background="#00FFCC" Margin="20,8,20,0" Height="1"/>
            </StackPanel>
        </Border>

        <!-- ═══ CHAT DISPLAY ═══ -->
        <Border Grid.Row="1" Margin="12,10,12,0"
                Background="#12122A"
                CornerRadius="8"
                BorderBrush="#2A2A5A"
                BorderThickness="1">
            <ScrollViewer x:Name="ChatScroller"
                          VerticalScrollBarVisibility="Auto"
                          Padding="10">
                <StackPanel x:Name="ChatPanel"
                            Margin="5"/>
            </ScrollViewer>
        </Border>

        <!-- ═══ INPUT AREA ═══ -->
        <Border Grid.Row="2" Margin="12,10,12,12"
                Background="#111127"
                CornerRadius="8"
                BorderBrush="#2A2A5A"
                BorderThickness="1"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UserInputBox"
                         Grid.Column="0"
                         Background="#1A1A3A"
                         Foreground="White"
                         CaretBrush="White"
                         BorderBrush="#3A3A6A"
                         BorderThickness="1"
                         FontSize="14"
                         Padding="10,8"
                         VerticalContentAlignment="Center"
                         KeyDown="UserInputBox_KeyDown"
                         ToolTip="Type your message here and press Enter or click Send"/>

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="Send ➤"
                        Margin="10,0,0,0"
                        Padding="18,8"
                        FontSize="14"
                        FontWeight="Bold"
                        Background="#00FFCC"
                        Foreground="#0D0D1A"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="SendButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
