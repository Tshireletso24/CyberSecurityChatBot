<Window x:Class="CyberSecurityChatBot.NamePromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome"
        Height="220" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0D0D1A"
        BorderBrush="#00FFCC"
        BorderThickness="1">

    <StackPanel Margin="25">

        <TextBlock Text="🛡 Welcome to CyberBot"
                   Foreground="#00FFCC"
                   FontSize="16"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <TextBlock Text="Please enter your name to get started:"
                   Foreground="#7EB8F7"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12"/>

        <TextBox x:Name="NameInputBox"
                 Background="#1A1A3A"
                 Foreground="White"
                 CaretBrush="White"
                 BorderBrush="#3A3A6A"
                 BorderThickness="1"
                 FontSize="14"
                 Padding="8,6"
                 KeyDown="NameInputBox_KeyDown"/>

        <TextBlock x:Name="ErrorLabel"
                   Text="⚠ Name cannot be empty."
                   Foreground="Red"
                   FontSize="11"
                   Margin="0,5,0,0"
                   Visibility="Collapsed"/>

        <Button Content="Let's Go ➤"
                Margin="0,14,0,0"
                Padding="12,7"
                FontSize="13"
                FontWeight="Bold"
                Background="#00FFCC"
                Foreground="#0D0D1A"
                BorderThickness="0"
                Cursor="Hand"
                HorizontalAlignment="Center"
                Click="ConfirmButton_Click"/>
    </StackPanel>
</Window>